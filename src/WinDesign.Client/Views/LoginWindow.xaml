<Window x:Class="WinDesign.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDesign 登录"
        Height="640" Width="1040"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="56,60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="WIN DESIGN" Foreground="#A3A3A3" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="仪表 · 电信 · IT" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,18,0,0" />
                    <TextBlock Text="一体化设计平台" Foreground="White" FontSize="34" FontWeight="Bold" />
                    <TextBlock Text="从工厂 PBS、设备索引、规格书，到材料附件与报表输出，统一在一个项目数据模型里完成。"
                               Foreground="#A3A3A3" FontSize="14" TextWrapping="Wrap" MaxWidth="430"
                               HorizontalAlignment="Left" Margin="0,22,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5E5" VerticalAlignment="Center" />
                        <TextBlock Text="项目化数据管理：一个项目一套设计数据" Foreground="#A3A3A3" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5E5" VerticalAlignment="Center" />
                        <TextBlock Text="角色权限：管理员 / 设计人员 / 只读用户" Foreground="#A3A3A3" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E5E5E5" VerticalAlignment="Center" />
                        <TextBlock Text="C/S 架构：本地客户端 + 中心服务端 + 数据库" Foreground="#A3A3A3" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="WINPCCAD 后继版本 · v0.1 骨架" Foreground="#737373" FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <StackPanel Width="380" VerticalAlignment="Center">
                <TextBlock Text="登录" Style="{StaticResource PageTitle}" />
                <TextBlock Text="使用项目账号进入设计平台" Style="{StaticResource MutedText}" Margin="0,8,0,26" />

                <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />

                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" />

                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                <Button Content="登 录" Style="{StaticResource PrimaryButton}" Height="42"
                        Margin="0,22,0,0" IsDefault="True" Click="OnLoginClick" />

                <TextBlock Text="正在连接服务器..." Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <Border Background="#F5F5F5" CornerRadius="8" Padding="12" Margin="0,26,0,0">
                    <StackPanel>
                        <TextBlock Text="默认账号" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="admin / admin123　·　designer / designer123" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
