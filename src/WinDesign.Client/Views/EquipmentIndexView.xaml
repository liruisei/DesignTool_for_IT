<UserControl x:Class="WinDesign.Client.Views.EquipmentIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="索引表录入" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="新建" Command="{Binding NewEquipmentCommand}" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="{Binding Context.CurrentProject.Name, TargetNullValue=请先在顶部选择项目，再录入索引表}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Width="170" Style="{StaticResource Input}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding FilterDisciplineOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding FilterDiscipline}" />
                    <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding FilterStatusOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding FilterStatus}" />
                    <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding PbsFilterOptions}"
                              DisplayMemberPath="Display" SelectedItem="{Binding FilterPbsNode}" />
                    <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位号" Binding="{Binding TagNo}" Width="110" />
                        <DataGridTextColumn Header="回路号" Binding="{Binding LoopNo}" Width="100" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeCode}" Width="70" />
                        <DataGridTextColumn Header="专业" Binding="{Binding Discipline}" Width="80" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="安装位置" Binding="{Binding Location}" Width="120" />
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60" />
                        <DataGridTextColumn Header="所属 PBS" Binding="{Binding PbsNodeName}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding Context.HasProject}">
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="按仪表索引表字段录入；位号在项目内唯一。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                    <TextBlock Text="基本信息" Style="{StaticResource SubSection}" />
                    <TextBlock Text="位号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditTagNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="回路号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLoopNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="设备类型" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EquipmentTypes}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding EditTypeCode}" />

                    <TextBlock Text="专业" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DisciplineOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding EditDiscipline}" />

                    <TextBlock Text="设计状态" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding EditStatus}" />

                    <TextBlock Text="数量" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="用途" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditPurpose, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="位置与关联" Style="{StaticResource SubSection}" />
                    <TextBlock Text="安装位置" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="所属 PBS" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PbsEditorOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Id" SelectedValue="{Binding EditPbsNodeId}" />

                    <TextBlock Text="管道设备号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditPipeEquipmentNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="图纸与文档" Style="{StaticResource SubSection}" />
                    <TextBlock Text="PID 图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditPidDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="规格书号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditSpecNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="规格书页号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditSpecPageNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="回路图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLoopDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="安装图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditInstallDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="电气图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditElectricalDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="供热图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditHeatSupplyDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="供气图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditAirSupplyDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="敷设图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLayingDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="接线箱图号" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditJunctionBoxDrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="其他" Style="{StaticResource SubSection}" />
                    <TextBlock Text="IO 设定" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditIoSetting, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="KeyWord" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditKeyword, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Index" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditIndexNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputMultiline}" MinHeight="70"
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <Expander Header="工艺条件 / 规格书" Margin="0,14,0,0" IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="工艺条件" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="80"
                                     Text="{Binding EditProcessCondition, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="规格书" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="80"
                                     Text="{Binding EditSpecification, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="新建" Command="{Binding NewEquipmentCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
