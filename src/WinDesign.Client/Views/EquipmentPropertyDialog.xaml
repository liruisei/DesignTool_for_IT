<Window x:Class="WinDesign.Client.Views.EquipmentPropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="660" Width="800"
        MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="按仪表索引表字段维护；位号在项目内唯一。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,14,0,0">
                <TabItem Header="基本信息">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel Margin="14,14,0,0">
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="位号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditTagNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="回路号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditLoopNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="设备类型" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding EquipmentTypes}" DisplayMemberPath="Name"
                                          SelectedValuePath="Code" SelectedValue="{Binding EditTypeCode}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="专业" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DisciplineOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Code" SelectedValue="{Binding EditDiscipline}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="设计状态" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Code" SelectedValue="{Binding EditStatus}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="数量" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="用途" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditPurpose, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="安装位置" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="所属 PBS" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PbsOptions}" DisplayMemberPath="Display"
                                          SelectedValuePath="Id" SelectedValue="{Binding EditPbsNodeId}" />
                            </StackPanel>
                        </WrapPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="图纸与文档">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel Margin="14,14,0,0">
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="PID 图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditPidDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="规格书号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditSpecNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="规格书页号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditSpecPageNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="回路图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditLoopDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="安装图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditInstallDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="电气图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditElectricalDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="供热图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditHeatSupplyDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="供气图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditAirSupplyDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="敷设图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditLayingDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="345" Margin="0,0,14,10">
                                <TextBlock Text="接线箱图号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding EditJunctionBoxDrawingNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="其他">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,0">
                            <WrapPanel>
                                <StackPanel Width="345" Margin="0,0,14,10">
                                    <TextBlock Text="管道设备号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding EditPipeEquipmentNo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="345" Margin="0,0,14,10">
                                    <TextBlock Text="IO 设定" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding EditIoSetting, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="345" Margin="0,0,14,10">
                                    <TextBlock Text="KeyWord" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding EditKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="345" Margin="0,0,14,10">
                                    <TextBlock Text="Index" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding EditIndexNo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="345" Margin="0,0,14,10">
                                    <TextBlock Text="排序" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}"
                                             Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="90"
                                     Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="工艺条件 / 规格书">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,0">
                            <TextBlock Text="工艺条件" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="120"
                                     Text="{Binding EditProcessCondition, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="规格书" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="120"
                                     Text="{Binding EditSpecification, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"
                            Padding="20,8" Click="OnCancel" />
                    <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Margin="8,0,0,0" Click="OnOk" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
