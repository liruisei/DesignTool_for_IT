<UserControl x:Class="WinDesign.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="工作台" Style="{StaticResource PageTitle}" />
            <TextBlock Text="项目、人员与基础数据概览" Style="{StaticResource MutedText}" Margin="0,6,0,22" />

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="用户总数" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding UserCount}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="系统账号" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="项目总数" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding ProjectCount}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="进行中与已归档" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="编码类型" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding DictionaryTypeCount}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="专业 / 设备 / 材料等" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="设备总数" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding EquipmentCount}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="仪表 / 电信 / IT" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="最近项目" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="按创建时间排序" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentProjects}" MinHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目代号" Binding="{Binding Code}" Width="130" />
                            <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="客户" Binding="{Binding ClientName}" Width="180" />
                            <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="当前阶段已具备" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="工厂（PBS 根节点）与多项目、工作区授权、项目配置、PBS管理、索引表已经打通服务端与客户端；设备规格、材料附件和报表输出已进入导航骨架，下一阶段接入业务。"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
