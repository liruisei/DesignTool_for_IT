<UserControl x:Class="WinDesign.Client.Views.PbsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PBS 目录树" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Plants.Count, StringFormat='共 {0} 个工厂'}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding SelectedPlantName, StringFormat='当前：{0}'}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding ProjectName, StringFormat='/ 项目：{0}'}"
                                   Visibility="{Binding ShowProjectContext, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新建工厂" Command="{Binding NewPlantCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="10,6"
                                Visibility="{Binding CanManagePlants, Converter={StaticResource BoolToVis}}" />
                        <Button Content="编辑工厂" Command="{Binding EditPlantCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,6"
                                Visibility="{Binding CanManagePlants, Converter={StaticResource BoolToVis}}" />
                        <Button Content="删除工厂" Command="{Binding DeletePlantCommand}"
                                Style="{StaticResource DangerButton}" Margin="6,0,0,0" Padding="10,6"
                                Visibility="{Binding CanManagePlants, Converter={StaticResource BoolToVis}}" />
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2,10,2"
                                Visibility="{Binding CanManagePlants, Converter={StaticResource BoolToVis}}" />
                        <Button Content="新建区域" Command="{Binding NewTopLevelCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" />
                        <Button Content="新建子节点" Command="{Binding NewChildCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="添加设备" Command="{Binding AddEquipmentCommand}"
                                IsEnabled="{Binding CanAddEquipment}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="编辑" Command="{Binding EditNodeCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="删除" Command="{Binding DeleteNodeCommand}"
                                Style="{StaticResource DangerButton}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="展开" Command="{Binding ExpandAllCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,6" />
                        <Button Content="折叠" Command="{Binding CollapseAllCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,6" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="所有工厂以根节点显示，可独立展开/折叠。右键菜单按节点层级裁剪：工厂根节点可维护工厂与区域；区域可维护区域/装置；装置可维护装置及下一层，依此类推。双击设备编辑属性。" />

                <TreeView Grid.Row="2" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                          SelectedItemChanged="OnSelectedItemChanged"
                          MouseDoubleClick="OnTreeMouseDoubleClick"
                          ContextMenuOpening="OnTreeContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="新建工厂（根节点）" Command="{Binding NewPlantCommand}"
                                      Visibility="{Binding CanManageFactoriesHere, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="编辑当前工厂" Command="{Binding EditPlantCommand}"
                                      Visibility="{Binding CanManageFactoriesHere, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="删除当前工厂" Command="{Binding DeletePlantCommand}"
                                      Visibility="{Binding CanManageFactoriesHere, Converter={StaticResource BoolToVis}}" />
                            <Separator Visibility="{Binding CanManageFactoriesHere, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="新建区域（顶层）" Command="{Binding NewTopLevelCommand}"
                                      Visibility="{Binding IsFactoryNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="新建子节点" Command="{Binding NewChildCommand}"
                                      Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="新建同级节点" Command="{Binding NewSiblingCommand}"
                                      Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="添加设备" Command="{Binding AddEquipmentCommand}"
                                      Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <Separator Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="编辑节点" Command="{Binding EditNodeCommand}"
                                      Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="删除节点" Command="{Binding DeleteNodeCommand}"
                                      Visibility="{Binding IsPbsNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <Separator />
                            <MenuItem Header="展开全部" Command="{Binding ExpandAllCommand}" />
                            <MenuItem Header="折叠全部" Command="{Binding CollapseAllCommand}" />
                            <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="4,5" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="14" Width="22"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HeaderCode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HeaderName}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
