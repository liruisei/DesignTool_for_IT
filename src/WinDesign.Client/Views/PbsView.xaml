<UserControl x:Class="WinDesign.Client.Views.PbsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PBS 树" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="新建节点" Command="{Binding NewNodeCommand}" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="{Binding Context.CurrentProject.Name, TargetNullValue=请先在顶部选择项目，再维护 PBS}" />

                <TreeView Grid.Row="2" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                          SelectedItemChanged="OnSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="4,4" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Node.Code}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Node.Name}" Margin="8,0,0,0" />
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                                        Padding="6,1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Node.EquipmentCount, StringFormat='设备 {0}'}"
                                               FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding Context.HasProject}">
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="PBS 节点按 区域 → 装置 → 系统 → 子系统 组织。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                    <TextBlock Text="节点编码" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="节点名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="节点类型" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding NodeTypeOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding EditNodeType}" />

                    <TextBlock Text="上级节点" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ParentOptions}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedParentOption}" />

                    <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputMultiline}" MinHeight="70"
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="新建" Command="{Binding NewNodeCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
