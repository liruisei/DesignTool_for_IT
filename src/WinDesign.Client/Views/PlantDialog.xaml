<Window x:Class="WinDesign.Client.Views.PlantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="560" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="工厂就是 PBS 的根节点；一个工厂可以承载多个项目。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="工厂编码" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsCreating}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="工厂名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="客户 / 业主" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditClient, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="地点" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputMultiline}" MinHeight="80"
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="启用该工厂" IsChecked="{Binding EditIsActive}" Margin="0,14,0,0" FontSize="13" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Click="OnCancel" />
                <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Margin="8,0,0,0" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
