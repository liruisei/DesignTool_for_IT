<ui:FluentWindow x:Class="WinDesign.AdminClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:WinDesign.AdminClient.ViewModels"
        xmlns:views="clr-namespace:WinDesign.AdminClient.Views"
        Title="工厂二维设计平台 - 管理客户端"
        Height="840" Width="1400"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectManagementViewModel}">
            <views:ProjectManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PbsViewModel}">
            <views:PbsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DictionaryViewModel}">
            <views:DictionaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="工厂二维设计平台 - 管理客户端"
                     Height="36" Padding="12,0" VerticalContentAlignment="Center" />

        <Menu Grid.Row="1" Padding="4,0" Background="Transparent"
              ItemContainerStyle="{StaticResource CompactTopMenuItem}">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding LogoutCommand}" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="项目配置" Command="{Binding OpenProjectConfigCommand}" />
                <MenuItem Header="PBS管理" Command="{Binding OpenPbsCommand}" />
                <MenuItem Header="编码管理" Command="{Binding OpenDictionariesCommand}" />
                <MenuItem Header="用户管理" Command="{Binding OpenUsersCommand}" />
                <Separator />
                <MenuItem Header="关闭当前标签" Command="{Binding CloseSelectedDocumentCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 工厂二维设计平台" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="管理模块" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="系统配置 · 跨工厂" Style="{StaticResource MutedText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:Button Content="⟳ 刷新" Command="{Binding RefreshCommand}"
                               Appearance="Secondary" Padding="10,4" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserDisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="10,6" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="系统配置" FontSize="12" FontWeight="SemiBold" />
                    </Border>

                    <TreeView Grid.Row="1" ItemsSource="{Binding ExplorerNodes}" Style="{StaticResource ExplorerTree}"
                              SelectedItemChanged="OnExplorerSelectedItemChanged"
                              ContextMenuOpening="OnExplorerContextMenuOpening">
                        <TreeView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开" Command="{Binding OpenSelectedExplorerNodeCommand}" />
                                <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource BoxedTreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="3,3" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" />

            <TabControl Grid.Column="2" ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Content="×" Style="{StaticResource TabCloseButton}"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsClosable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding ViewModel}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <Border Grid.Row="4" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工作区：" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WorkspaceText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding UserName}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="  |  " Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
