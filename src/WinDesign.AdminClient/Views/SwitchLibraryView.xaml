<UserControl x:Class="WinDesign.AdminClient.Views.SwitchLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="460" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="设备样本库" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding ModelRows.Count, StringFormat='共 {0} 个设备样本'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新建" Command="{Binding NewModelCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" />
                        <Button Content="保存" Command="{Binding SaveActiveChangesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6"
                                IsEnabled="{Binding HasPendingActiveChanges}"
                                ToolTip="保存列表中勾选的启用/停用状态" />
                        <Button Content="删除" Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="交换机（接入 / PoE）只是设备样本的一种，机柜等其他设备同样在此维护；设计端电信统计按接入与 PoE 样本的端口规格计算台数。" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding ModelRows}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="类型" Binding="{Binding SwitchTypeText}" Width="100" />
                        <DataGridTextColumn Header="端口" Binding="{Binding ElectricalPorts}" Width="60" />
                        <DataGridTextColumn Header="上联口" Binding="{Binding UplinkPorts}" Width="70" />
                        <DataGridTemplateColumn Header="启用" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              ToolTip="勾选启用，取消勾选停用；修改后点上方「保存」提交" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                <StackPanel Grid.Row="1">
                    <TextBlock Text="编码" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}" Margin="0,4,0,10"
                             Text="{Binding EditorCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}" Margin="0,4,0,10"
                             Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                    <ComboBox Margin="0,4,0,10" ItemsSource="{Binding DeviceTypeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding EditorSwitchType}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="端口数量（交换机必填）" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,4,0,0"
                                     Text="{Binding EditorElectricalPorts, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="上联口数量" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,4,0,0"
                                     Text="{Binding EditorUplinkPorts, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" Margin="0,4,0,0"
                                     Text="{Binding EditorSortOrder, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="启用" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                  IsChecked="{Binding EditorIsActive}" />
                    </Grid>

                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}" Margin="0,4,0,0" Height="70"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding EditorRemark, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="保存设备样本" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,7" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
