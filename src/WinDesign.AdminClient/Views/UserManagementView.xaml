<UserControl x:Class="WinDesign.AdminClient.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户列表" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource Input}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="查询" Command="{Binding SearchCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="新建" Command="{Binding NewUserCommand}"
                            Click="OnNewUserClick"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                    <Button Grid.Column="4" Content="保存"
                            Command="{Binding SaveActiveChangesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding HasPendingActiveChanges}"
                            ToolTip="保存列表中勾选的启用/停用状态" />
                    <Button Grid.Column="5" x:Name="ToggleEditorButton" Content="展开编辑"
                            Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Click="OnToggleEditorClick" ToolTip="展开/收起右侧编辑栏" />
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding UserRows}" SelectedItem="{Binding SelectedUserRow}"
                          PreviewMouseRightButtonDown="OnUsersGridPreviewMouseRightButtonDown"
                          ContextMenuOpening="OnUsersGridContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="修改" Click="OnEditUserClick" />
                            <MenuItem Header="删除" Click="OnDeleteUserClick" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="130" />
                        <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="用户类" Binding="{Binding RolesText}" Width="150" />
                        <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="200" />
                        <DataGridTemplateColumn Header="启用" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              ToolTip="勾选启用，取消勾选停用；修改后点上方「保存」提交" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="最近登录"
                                            Binding="{Binding LastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}" Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      ToolTip="拖动调整编辑栏宽度；向左拖到底可收起" />

        <Border Grid.Column="2" x:Name="EditorPanel" Style="{StaticResource Card}" Margin="4,0,0,0"
                Visibility="Collapsed"
                SizeChanged="OnEditorPanelSizeChanged"
                LostKeyboardFocus="OnEditorLostKeyboardFocus">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="用户类决定全局模块的增删改查权限；可选择多个用户类，权限取并集。项目内的准入与成员角色在「项目配置 → 成员配置」中单独授权。"
                               Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsCreating}"
                             Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="邮箱" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="电话" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="PasswordHidden" Style="{StaticResource PasswordInput}"
                                     Height="38" PasswordChanged="OnPasswordChanged" />
                        <TextBox x:Name="PasswordVisible" Style="{StaticResource Input}"
                                 Height="38" Visibility="Collapsed"
                                 Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}" />

                        <Button x:Name="PasswordEyeButton" Grid.Column="1" Content="&#xE052;"
                                FontFamily="Segoe MDL2 Assets" FontSize="15"
                                Style="{StaticResource ToolButton}" Width="34" Height="38"
                                Margin="6,0,0,0" Click="OnTogglePasswordVisibility"
                                ToolTip="显示密码" />
                    </Grid>
                    <TextBlock Text="创建用户或重置密码时填写，至少 6 位。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />

                    <TextBlock Text="用户类" Style="{StaticResource FieldLabel}" />
                    <DataGrid ItemsSource="{Binding RoleOptions}" Height="132"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="用户类" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="勾选" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <CheckBox Content="启用该账号" IsChecked="{Binding EditIsActive}" Margin="0,14,0,0" FontSize="13" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="新建" Command="{Binding NewUserCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="重置密码" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="启用 / 停用" Command="{Binding ToggleActiveCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
