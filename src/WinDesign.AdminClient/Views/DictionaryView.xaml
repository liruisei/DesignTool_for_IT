<UserControl x:Class="WinDesign.AdminClient.Views.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="0" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="EditorColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="编码类型" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新建" Command="{Binding NewTypeCommand}" Click="OnNewTypeClick"
                                    Style="{StaticResource PrimaryButton}" Padding="8,5" />
                            <Button Content="删除" Command="{Binding DeleteTypeCommand}" Style="{StaticResource DangerButton}"
                                    Margin="6,0,0,0" Padding="8,5" IsEnabled="{Binding HasSelectedType}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                             BorderThickness="0" Background="Transparent"
                             PreviewMouseLeftButtonUp="OnTypeListMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                    <TextBlock Text="{Binding Code}" FontSize="10.5" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="编码项" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新建" Command="{Binding NewItemCommand}" Click="OnNewItemClick"
                                    Style="{StaticResource PrimaryButton}" Padding="8,5" />
                            <Button Content="删除" Command="{Binding DeleteItemCommand}" Style="{StaticResource DangerButton}"
                                    Margin="6,0,0,0" Padding="8,5" IsEnabled="{Binding HasSelectedItem}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              PreviewMouseLeftButtonUp="OnItemGridMouseLeftButtonUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ToolTip="拖动调整编辑栏宽度" />

            <!-- 两个编辑栏共用同一列，互斥显示：点编码类型显示类型编辑，点编码项显示编码项编辑 -->
            <Border Grid.Column="3" x:Name="TypeEditorPanel" Style="{StaticResource Card}" Margin="0"
                    Visibility="Collapsed"
                    SizeChanged="OnEditorPanelSizeChanged"
                    LostKeyboardFocus="OnEditorLostKeyboardFocus">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TypeEditorTitle}" Style="{StaticResource SectionTitle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="收起编辑" Style="{StaticResource ToolButton}"
                                VerticalAlignment="Center" Click="OnCollapseEditorClick"
                                ToolTip="收起当前编辑栏" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="系统内置类型可以修改名称，但不能删除。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                        <TextBlock Text="类型编码" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsCreatingType}"
                                 Text="{Binding EditTypeCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="类型名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditTypeName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource InputMultiline}" MinHeight="60"
                                 Text="{Binding EditTypeDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding EditTypeSort, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="保存类型" Command="{Binding SaveTypeCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="取消" Command="{Binding CancelTypeEditCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="3" x:Name="ItemEditorPanel" Style="{StaticResource Card}" Margin="0"
                    Visibility="Collapsed"
                    SizeChanged="OnEditorPanelSizeChanged"
                    LostKeyboardFocus="OnEditorLostKeyboardFocus">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ItemEditorTitle}" Style="{StaticResource SectionTitle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="收起编辑" Style="{StaticResource ToolButton}"
                                VerticalAlignment="Center" Click="OnCollapseEditorClick"
                                ToolTip="收起当前编辑栏" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="请先在左侧选择编码类型" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedType}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedType}" Value="True">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="编码" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsCreatingItem}"
                                     Text="{Binding EditItemCode, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding EditItemSort, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="启用该编码项" IsChecked="{Binding EditItemActive}" Margin="0,12,0,0" FontSize="13" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存编码项" Command="{Binding SaveItemCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="取消" Command="{Binding CancelItemEditCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
