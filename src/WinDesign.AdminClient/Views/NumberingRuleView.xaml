<UserControl x:Class="WinDesign.AdminClient.Views.NumberingRuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="编号规定" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="管理员先选择项目，再为该项目定义设备位号（Equip Tag）由哪些字段组成，保证项目内编号口径一致。下拉中是字段名，不是具体数据值。" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="480" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="项目" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              ToolTip="编号规定按项目维护，先选择要定义的项目">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="① 前缀字段" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="300" ItemsSource="{Binding PrefixFieldOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding PrefixField}"
                                  ToolTip="定义前缀取哪个字段；选「空」则允许使用者手动输入" />
                        <TextBlock Text="长度" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="10,0,6,0" />
                        <TextBox Width="60" Style="{StaticResource Input}"
                                 Text="{Binding PrefixLength, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding PrefixLengthEditable}"
                                 ToolTip="装置编号作为前缀时由数据长度决定，不可修改" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="前缀后分隔符" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Width="70" HorizontalAlignment="Left"
                              ItemsSource="{Binding SeparatorOptions}"
                              SelectedItem="{Binding PrefixSeparator}"
                              ToolTip="只能为「-」或留空" />

                    <TextBlock Grid.Row="3" Text="② 设备类型字段" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox Width="300" ItemsSource="{Binding EquipmentTypeFieldOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding EquipmentTypeField}"
                                  ToolTip="定义设备类型段取哪个字段；选「空」则允许使用者手动输入" />
                        <TextBlock Text="长度" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="10,0,6,0" />
                        <TextBox Width="60" Style="{StaticResource Input}"
                                 Text="{Binding TypeLength, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="设备类型编码的显示长度（不足补空格）" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="设备类型后分隔符" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Width="70" HorizontalAlignment="Left"
                              ItemsSource="{Binding SeparatorOptions}"
                              SelectedItem="{Binding TypeSeparator}"
                              ToolTip="只能为「-」或留空" />

                    <TextBlock Grid.Row="5" Text="③ 顺序号" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Padding="10,5" MinWidth="90"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                Background="#F7F9FC">
                            <TextBlock Text="{Binding SequenceDisplay}" FontFamily="Consolas" FontSize="15"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="长度" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="10,0,6,0" />
                        <TextBox Width="60" Style="{StaticResource Input}"
                                 Text="{Binding SequenceLength, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="顺序号长度，默认 4 位" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" Text="④ 后缀（可选）" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Width="120" Style="{StaticResource Input}"
                                 Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空，或输入 A/B/C/D 等后缀" />
                        <TextBlock Text="长度" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="10,0,6,0" />
                        <TextBox Width="60" Style="{StaticResource Input}"
                                 Text="{Binding SuffixLength, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="后缀字段长度，0 表示不限制显示宽度" />
                    </StackPanel>

                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="{Binding TypeCodeHint}" />
                </Grid>

                <Border Grid.Row="2" Margin="0,20,0,0" Padding="14,12"
                        Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="位号模板预览（字段名 + 顺序号占位）" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="22"
                                   FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <Button Content="保存编号规定" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,7" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
