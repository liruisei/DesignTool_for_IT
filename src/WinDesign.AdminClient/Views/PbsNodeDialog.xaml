<Window x:Class="WinDesign.AdminClient.Views.PbsNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="维护节点编码、名称、类型与上级节点。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="上级节点" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding ParentOptions}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedParentOption}" />

                    <TextBlock Text="节点类型" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding NodeTypeOptions}" DisplayMemberPath="Name"
                              SelectedValuePath="Code" SelectedValue="{Binding EditNodeType}"
                              IsEnabled="{Binding CanChooseNodeType}" />

                    <TextBlock Text="节点编码" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="节点名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="排序" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource InputMultiline}" MinHeight="80"
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Click="OnCancel" />
                <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Margin="8,0,0,0" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
