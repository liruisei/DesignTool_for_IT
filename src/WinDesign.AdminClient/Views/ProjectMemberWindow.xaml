<Window x:Class="WinDesign.AdminClient.Views.ProjectMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding EditorTitle, StringFormat='成员配置 - {0}'}"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="580"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="成员配置" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="只有项目成员才能进入该项目。项目角色只控制准入与成员维护；具体增删改查由用户在「权限管理」中的全局权限决定。" />
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,12,0,0">
                <TabItem Header="现有成员">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="140" />
                                <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="项目角色" Binding="{Binding RoleInProject}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding MemberRoleOptions}"
                                      SelectedItem="{Binding EditMemberRole}"
                                      DisplayMemberPath="Name" SelectedValuePath="Code"
                                      Width="120" />
                            <Button Content="更新角色" Command="{Binding UpdateMemberRoleCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanEditSelectedMember}" />
                            <Button Content="移除成员" Command="{Binding RemoveMemberCommand}"
                                    Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanEditSelectedMember}" />
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="项目负责人不能被移除或降级。" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="授权用户">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="全选" Command="{Binding SelectAllUsersCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="清空勾选" Command="{Binding ClearUserSelectionCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="勾选用户名，选择项目角色后点击「确认授权」。" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" Margin="0,10,0,0"
                                  ItemsSource="{Binding UserSelectionItems}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选择" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="150" />
                                <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="项目角色" Style="{StaticResource FieldLabel}" Margin="0"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding MemberRoleOptions}"
                                      SelectedItem="{Binding GrantRole}"
                                      DisplayMemberPath="Name" SelectedValuePath="Code"
                                      Width="120" Margin="8,0,0,0" />
                            <Button Content="确认授权" Command="{Binding GrantMembersCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,8" Click="OnClose" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</Window>
