<ui:FluentWindow x:Class="WinDesign.DesignClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:WinDesign.DesignClient.ViewModels"
        xmlns:views="clr-namespace:WinDesign.DesignClient.Views"
        Title="工厂二维设计平台 - 设计客户端"
        Height="840" Width="1400"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">
    <ui:FluentWindow.Resources>
        <!-- 左侧两个 Explorer 面板共用：标题栏、节点容器与节点模板。 -->
        <Style x:Key="ExplorerHeaderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ExplorerItemContainerStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource BoxedTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="3,3" />
        </Style>
        <HierarchicalDataTemplate x:Key="ExplorerItemTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{StaticResource AccentBrush}"
                           FontFamily="{Binding GlyphFontFamily}" />
                <TextBlock Text="{Binding Title}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:EquipmentIndexViewModel}">
            <views:EquipmentIndexView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EquipmentSpecIndexViewModel}">
            <views:EquipmentSpecIndexView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaterialIndexViewModel}">
            <views:MaterialIndexView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TelecomStatsViewModel}">
            <views:TelecomStatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModulePlaceholderViewModel}">
            <views:ModulePlaceholderView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="工厂二维设计平台 - 设计客户端"
                     Height="36" Padding="12,0" VerticalContentAlignment="Center" />

        <Menu Grid.Row="1" Padding="4,0" Background="Transparent"
              ItemContainerStyle="{StaticResource CompactTopMenuItem}">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="切换工作区..." Command="{Binding SwitchWorkspaceCommand}" />
                <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding LogoutCommand}" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="索引表" Command="{Binding OpenIndexCommand}" />
                <MenuItem Header="规格书" Command="{Binding OpenSpecsCommand}" />
                <MenuItem Header="材料表" Command="{Binding OpenMaterialsCommand}" />
                <MenuItem Header="报表输出" Command="{Binding OpenReportsCommand}" />
                <Separator />
                <MenuItem Header="关闭当前标签" Command="{Binding CloseSelectedDocumentCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 工厂二维设计平台" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="工厂" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding PlantName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text=" / 项目" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:Button x:Name="SwitchWorkspaceButton" Content="⇄ 切换工作区"
                               Command="{Binding SwitchWorkspaceCommand}"
                               Appearance="Secondary" Padding="10,4" Margin="0,0,6,0" />
                    <ui:Button Content="⟳ 刷新" Command="{Binding RefreshCommand}"
                               Appearance="Secondary" Padding="10,4" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserDisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="250" MinWidth="0" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="3*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- 上方：项目资源浏览 -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource ExplorerHeaderStyle}">
                            <TextBlock Text="Project Explorer" FontSize="12" FontWeight="SemiBold" />
                        </Border>

                        <TreeView x:Name="ProjectExplorerTree" Grid.Row="1"
                                  ItemsSource="{Binding ProjectExplorerNodes}" Style="{StaticResource ExplorerTree}"
                                  ItemContainerStyle="{StaticResource ExplorerItemContainerStyle}"
                                  ItemTemplate="{StaticResource ExplorerItemTemplate}"
                                  SelectedItemChanged="OnProjectExplorerSelectedItemChanged"
                                  MouseDoubleClick="OnProjectExplorerMouseDoubleClick"
                                  ContextMenuOpening="OnProjectExplorerContextMenuOpening">
                            <TreeView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="打开" Command="{Binding OpenSelectedProjectNodeCommand}" />
                                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Grid>

                    <!-- 可上下拖拽的分隔条：调整两个 Explorer 的高度 -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="{StaticResource BorderBrush}" />

                    <!-- 下方：PBS 资源浏览（只读） -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource ExplorerHeaderStyle}">
                            <TextBlock Text="PBS Explorer" FontSize="12" FontWeight="SemiBold" />
                        </Border>

                        <TreeView x:Name="PbsExplorerTree" Grid.Row="1"
                                  ItemsSource="{Binding PbsExplorerNodes}" Style="{StaticResource ExplorerTree}"
                                  ItemContainerStyle="{StaticResource ExplorerItemContainerStyle}"
                                  ItemTemplate="{StaticResource ExplorerItemTemplate}"
                                  SelectedItemChanged="OnPbsExplorerSelectedItemChanged"
                                  ContextMenuOpening="OnPbsExplorerContextMenuOpening">
                            <TreeView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="新增" Command="{Binding AddCategoryItemCommand}"
                                              Visibility="{Binding IsCategoryFolderSelected, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="编辑" Command="{Binding EditPbsBuildingCommand}"
                                              Visibility="{Binding IsBuildingNodeSelected, Converter={StaticResource BoolToVis}}" />
                                    <Separator Visibility="{Binding ShowPbsContextActions, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <!-- 整条隔断既是拖拽条也是收起/展开热区：单击切换、拖动调宽，悬停显示小手。
                 分隔条必须是外层 Grid 的直接子元素，否则找不到相邻列、无法拖动调宽。 -->
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                    Background="{StaticResource BorderBrush}" IsHitTestVisible="False" />
            <GridSplitter Grid.Column="1" x:Name="ExplorerSplitter" Width="18" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Cursor="Hand"
                          ToolTip="单击收起左侧面板；拖动可调整宽度"
                          DragStarted="OnExplorerSplitterDragStarted"
                          DragDelta="OnExplorerSplitterDragDelta"
                          PreviewMouseLeftButtonUp="OnExplorerSplitterPreviewMouseLeftButtonUp"
                          DragCompleted="OnExplorerSplitterDragCompleted" />
            <Border Grid.Column="1" x:Name="ExplorerToggleHandle" Width="18" Height="64" CornerRadius="7"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="1" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="6" ShadowDepth="1" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ExplorerSplitter}" Value="True">
                                <Setter Property="Background" Value="#F2F2F2" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="ExplorerToggleGlyph" Text="‹" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TabControl Grid.Column="2" ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Content="×" Style="{StaticResource TabCloseButton}"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsClosable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding ViewModel}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <Border Grid.Row="4" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工作区：" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WorkspaceText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding UserName}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="  |  " Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
