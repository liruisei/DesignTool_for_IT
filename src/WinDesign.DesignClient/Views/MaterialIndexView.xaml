<UserControl x:Class="WinDesign.DesignClient.Views.MaterialIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="材料表" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Context.CurrentProject.Name, TargetNullValue=请先在顶部选择项目}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                IsEnabled="{Binding Context.HasProject}">
                        <Button Content="新建" Command="{Binding NewMaterialCommand}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding CanWrite}" Padding="12,6" />
                        <Button Content="打开/编辑" Command="{Binding OpenMaterialCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="删除" Command="{Binding DeleteMaterialCommand}" Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding CanWrite}" Margin="6,0,0,0" Padding="12,6" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="双击行打开材料；材料按当前项目范围显示，可关联项目内的设备。" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Width="230" Style="{StaticResource Input}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="260" Margin="8,0,0,0" ItemsSource="{Binding EquipmentFilterOptions}"
                              DisplayMemberPath="Display" SelectedItem="{Binding FilterEquipment}" />
                    <Button Content="查询" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                          MouseDoubleClick="OnGridMouseDoubleClick" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="材料编码" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="110" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="90" />
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="70" />
                        <DataGridTextColumn Header="关联设备" Binding="{Binding EquipmentTagNo}" Width="110" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="1.5*" />
                        <DataGridTextColumn Header="更新时间" Width="140"
                                            Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
