<UserControl x:Class="WinDesign.DesignClient.Views.TelecomStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题与工具栏：所有操作都在本页完成，不弹窗 -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="电信统计" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Context.CurrentProject.Name, TargetNullValue=请先在顶部选择项目}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新增房间" Command="{Binding AddRoomCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6"
                                IsEnabled="{Binding CanWrite}" />
                        <Button Content="删除选中" Command="{Binding DeleteRoomCommand}"
                                Style="{StaticResource DangerButton}" Margin="6,0,0,0" Padding="12,6"
                                IsEnabled="{Binding CanWrite}" />
                        <Button Content="保存更改" Command="{Binding SaveChangesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6"
                                IsEnabled="{Binding CanWrite}" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <!-- 关键指标 -->
                <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="建筑物" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding BuildingCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="楼层" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding FloorCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="房间" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding RoomCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="信息点" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding DataPointTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="电话点" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding PhonePointTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="无线 AP" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding ApTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="接入交换机" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding AccessSwitchTotal}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PoE 交换机" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding PoeSwitchTotal}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- 左右分隔条：拖动可调整房间明细与汇总区的宽度 -->
                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  Cursor="SizeWE" ToolTip="拖动调整左右区域宽度">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- 房间明细：内联编辑 -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="房间明细（信息点 / 电话点 / 无线 AP）" Style="{StaticResource SectionTitle}"
                                       Margin="10,8,10,6" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Rooms}"
                                      SelectedItem="{Binding SelectedRoom}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="{Binding IsReadOnly}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="建筑物" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.BuildingOptions,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          DisplayMemberPath="Display"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding PbsNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding DataContext.CanWrite,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          BorderThickness="0" Background="Transparent" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="楼层" Width="70"
                                                        Binding="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="房间编码" Width="95"
                                                        Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="房间名称" Width="*"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="信息点" Width="68"
                                                        Binding="{Binding DataPointCount, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="电话点" Width="68"
                                                        Binding="{Binding PhonePointCount, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="无线 AP" Width="68"
                                                        Binding="{Binding ApCount, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="备注" Width="140"
                                                        Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 交换机选型：规格来自样本库，可用率在本页调整 -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="交换机计算" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="接入交换机" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AccessSwitchModels}"
                                              SelectedItem="{Binding SelectedAccessSwitch}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding ElectricalPorts, StringFormat='（{0} 口）'}"
                                                               Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="PoE 交换机" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                              ItemsSource="{Binding PoeSwitchModels}"
                                              SelectedItem="{Binding SelectedPoeSwitch}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding ElectricalPorts, StringFormat='（{0} 口）'}"
                                                               Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="可用率 %" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Width="90"
                                             HorizontalAlignment="Left"
                                             Text="{Binding UtilizationPercent, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="规格来自「设备样本库」中的交换机样本；接入交换机按信息点计算，PoE 交换机按无线 AP 计算，电话点不占用交换机电口。" />
                            </StackPanel>
                        </Border>

                        <!-- 汇总 -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <TabControl BorderThickness="0" Background="Transparent">
                                <TabItem Header="按房间汇总">
                                    <DataGrid ItemsSource="{Binding RoomSummaries}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="建筑物" Binding="{Binding Building}" Width="*" />
                                            <DataGridTextColumn Header="楼层" Binding="{Binding Floor}" Width="60" />
                                            <DataGridTextColumn Header="房间" Binding="{Binding Room}" Width="150" />
                                            <DataGridTextColumn Header="信息点" Binding="{Binding DataPointCount}" Width="58" />
                                            <DataGridTextColumn Header="电话点" Binding="{Binding PhonePointCount}" Width="58" />
                                            <DataGridTextColumn Header="AP" Binding="{Binding ApCount}" Width="46" />
                                            <DataGridTextColumn Header="接入" Binding="{Binding AccessSwitchCount}" Width="46" />
                                            <DataGridTextColumn Header="PoE" Binding="{Binding PoeSwitchCount}" Width="46" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="按楼层汇总">
                                    <DataGrid ItemsSource="{Binding FloorSummaries}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="建筑物" Binding="{Binding Building}" Width="*" />
                                            <DataGridTextColumn Header="楼层" Binding="{Binding Floor}" Width="70" />
                                            <DataGridTextColumn Header="房间" Binding="{Binding RoomCount}" Width="52" />
                                            <DataGridTextColumn Header="信息点" Binding="{Binding DataPointCount}" Width="58" />
                                            <DataGridTextColumn Header="电话点" Binding="{Binding PhonePointCount}" Width="58" />
                                            <DataGridTextColumn Header="AP" Binding="{Binding ApCount}" Width="46" />
                                            <DataGridTextColumn Header="接入" Binding="{Binding AccessSwitchCount}" Width="46" />
                                            <DataGridTextColumn Header="PoE" Binding="{Binding PoeSwitchCount}" Width="46" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="按建筑物汇总">
                                    <DataGrid ItemsSource="{Binding BuildingSummaries}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="建筑物" Binding="{Binding Building}" Width="*" />
                                            <DataGridTextColumn Header="房间" Binding="{Binding RoomCount}" Width="52" />
                                            <DataGridTextColumn Header="信息点" Binding="{Binding DataPointCount}" Width="58" />
                                            <DataGridTextColumn Header="电话点" Binding="{Binding PhonePointCount}" Width="58" />
                                            <DataGridTextColumn Header="AP" Binding="{Binding ApCount}" Width="46" />
                                            <DataGridTextColumn Header="接入" Binding="{Binding AccessSwitchCount}" Width="46" />
                                            <DataGridTextColumn Header="PoE" Binding="{Binding PoeSwitchCount}" Width="46" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
