<UserControl x:Class="WinDesign.DesignClient.Views.TelecomStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 单元格文本：显式与下拉框使用同一字体、同一垂直居中方式。 -->
        <Style x:Key="TelecomCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <!-- 单元格内的下拉框：主题默认高 32，会撑破 28 的行高，导致文字上下不齐。 -->
        <Style x:Key="TelecomCellComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 表头筛选下拉：可下拉选已有值，也可直接输入任意文字。 -->
        <Style x:Key="TelecomHeaderFilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 表头：拖拽手柄 + 标题 + 排序标记 + 本列筛选下拉。 -->
        <DataTemplate x:Key="TelecomFilterHeaderTemplate">
            <StackPanel ToolTip="点击标题排序；可从下拉选择已有值，也可输入内容按本列筛选">
                <!-- 标题行是列拖拽区域：按住左右拖动可调整列顺序；筛选下拉仍可正常使用 -->
                <StackPanel Orientation="Horizontal" Cursor="SizeWE"
                            ToolTip="按住表头左右拖动可调整列顺序">
                    <TextBlock Text="≡" FontSize="10" Margin="0,0,4,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" />
                    <TextBlock x:Name="SortGlyph" Margin="4,0,0,0" FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox Style="{StaticResource TelecomHeaderFilterCombo}"
                          Tag="{Binding Column, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                          Loaded="OnRoomFilterComboLoaded"
                          DropDownOpened="OnRoomFilterDropDownOpened"
                          DropDownClosed="OnRoomFilterDropDownClosed" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                             Value="Ascending">
                    <Setter TargetName="SortGlyph" Property="Text" Value="▲" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}"
                             Value="Descending">
                    <Setter TargetName="SortGlyph" Property="Text" Value="▼" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 房间行样式：冻结区与滚动区共用，右键菜单在两块区域都可用。 -->
        <Style x:Key="TelecomRoomRowStyle" TargetType="DataGridRow">
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="{Binding PlacementTarget.Tag.DeleteMenuHeader,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Command="{Binding PlacementTarget.Tag.DeleteRowCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.Tag.CanWrite,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题与工具栏：所有操作都在本页完成，不弹窗 -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="信息设计" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Context.CurrentProject.Name, TargetNullValue=请先在顶部选择项目}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新增房间" Command="{Binding AddRoomCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6"
                                IsEnabled="{Binding CanWrite}" />
                        <Button Content="保存更改" Command="{Binding SaveChangesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,6"
                                IsEnabled="{Binding CanWrite}" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <!-- 关键指标 -->
                <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="建筑物" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding BuildingCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="楼层" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding FloorCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="房间" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding RoomCount}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="信息点" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding DataPointTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="电话点" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding PhonePointTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="无线 AP" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding ApTotal}" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="接入交换机" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding AccessSwitchTotal}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PoE 交换机" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding PoeSwitchTotal}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- 左右分隔条：拖动可调整房间明细与汇总区的宽度 -->
                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  Cursor="SizeWE" ToolTip="拖动调整左右区域宽度">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- 房间明细：内联编辑；勾选列与冻结列固定，其余列横向滚动 -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="房间明细（信息点 / 电话点 / 无线 AP）" Style="{StaticResource SectionTitle}"
                                       Margin="10,8,10,6" />

                            <Grid Grid.Row="1" Loaded="OnRoomGridsLoaded">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 冻结区：勾选列 + 前 N 个数据列；纵向滚动与右侧表格同步 -->
                                <DataGrid x:Name="FrozenRoomGrid" Grid.Column="0"
                                          ItemsSource="{Binding Rooms}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="{Binding IsReadOnly}"
                                          SelectionMode="Extended" SelectionUnit="FullRow"
                                          SelectionChanged="OnFrozenRoomSelectionChanged"
                                          PreviewMouseLeftButtonDown="OnRoomGridPreviewMouseLeftButtonDown"
                                          PreviewMouseRightButtonDown="OnRoomRightButtonDown"
                                          ColumnReordered="OnRoomColumnReordered"
                                          ColumnReordering="OnRoomColumnReordering"
                                          RowStyle="{StaticResource TelecomRoomRowStyle}"
                                          ColumnHeaderHeight="52" CanUserSortColumns="True"
                                          CanUserResizeColumns="True" CanUserReorderColumns="True"
                                          HeadersVisibility="Column"
                                          HorizontalAlignment="Left"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="0,0,1,0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <DataGrid.Columns>
                                        <!-- 行首勾选框：与索引表一致，勾选即选中行，支持多选后右键批量删除。 -->
                                        <DataGridTemplateColumn Width="30" CanUserSort="False">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource CompactRowCheckBox}"
                                                              Focusable="False"
                                                              IsThreeState="True"
                                                              ToolTip="全选 / 取消全选当前列表"
                                                              Loaded="OnSelectAllCheckBoxLoaded"
                                                              PreviewMouseLeftButtonDown="OnSelectAllCheckBoxPreviewMouseLeftButtonDown" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource CompactRowCheckBox}"
                                                              Focusable="False"
                                                              PreviewMouseLeftButtonDown="OnRoomCheckBoxPreviewMouseLeftButtonDown"
                                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 可横向滚动区：其余数据列 -->
                                <DataGrid x:Name="RoomGrid" Grid.Column="1" ItemsSource="{Binding Rooms}"
                                          SelectedItem="{Binding SelectedRoom}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="{Binding IsReadOnly}"
                                          SelectionMode="Extended" SelectionUnit="FullRow"
                                          SelectionChanged="OnRoomSelectionChanged"
                                          PreviewMouseLeftButtonDown="OnRoomGridPreviewMouseLeftButtonDown"
                                          PreviewMouseRightButtonDown="OnRoomRightButtonDown"
                                          ColumnReordered="OnRoomColumnReordered"
                                          ColumnReordering="OnRoomColumnReordering"
                                          RowStyle="{StaticResource TelecomRoomRowStyle}"
                                          ColumnHeaderHeight="52" CanUserSortColumns="True"
                                          CanUserResizeColumns="True" CanUserReorderColumns="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <!-- 先选装置，再在装置下的建筑物中选择；两列都只显示编码。
                                             模板列必须显式指定 SortMemberPath，否则表头点击无法排序。 -->
                                        <DataGridTemplateColumn Header="装置" Width="80" MinWidth="70"
                                                                SortMemberPath="UnitCode"
                                                                HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource TelecomCellComboBox}"
                                                              ItemsSource="{Binding UnitOptions}"
                                                              DisplayMemberPath="Display"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.CanWrite,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="建筑物" Width="100" MinWidth="90"
                                                                SortMemberPath="BuildingCode"
                                                                HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource TelecomCellComboBox}"
                                                              ItemsSource="{Binding BuildingOptions}"
                                                              DisplayMemberPath="Display"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding PbsNodeId, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding DataContext.CanWrite,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="楼层" Width="70" MinWidth="60"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" />
                                        <!-- 房间编码与房间名称合并为「房间号」：以编码作为唯一标识。 -->
                                        <DataGridTextColumn Header="房间号" Width="90" MinWidth="70"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="信息点" Width="80" MinWidth="70"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding DataPointCount, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="电话点" Width="80" MinWidth="70"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding PhonePointCount, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="无线 AP" Width="90" MinWidth="80"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding ApCount, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="备注" Width="130" MinWidth="100"
                                                            HeaderTemplate="{StaticResource TelecomFilterHeaderTemplate}"
                                                            ElementStyle="{StaticResource TelecomCellText}"
                                                            Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- 冻结列配置：默认收起，点按钮呼出；配置完可再次收起 -->
                            <Grid Grid.Row="2" Margin="10,4,10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FreezeSettingsButton" Content="冻结列设置"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,3" Click="OnFreezeSettingsClick" />
                                    <StackPanel x:Name="FreezeSettingsPanel" Orientation="Horizontal"
                                                Visibility="Collapsed" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="冻结前" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="FrozenColumnCountBox" Width="64" Margin="6,0"
                                                  SelectedIndex="0" SelectionChanged="OnFrozenColumnCountChanged">
                                            <ComboBoxItem Content="0" />
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                        </ComboBox>
                                        <TextBlock Text="列（勾选列始终固定）" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 交换机选型：规格来自样本库，可用率在本页调整 -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="交换机计算" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="接入交换机" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AccessSwitchModels}"
                                              SelectedItem="{Binding SelectedAccessSwitch}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding ElectricalPorts, StringFormat='（{0} 口）'}"
                                                               Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="PoE 交换机" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                              ItemsSource="{Binding PoeSwitchModels}"
                                              SelectedItem="{Binding SelectedPoeSwitch}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding ElectricalPorts, StringFormat='（{0} 口）'}"
                                                               Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="可用率 %" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Width="90"
                                             HorizontalAlignment="Left"
                                             Text="{Binding UtilizationPercent, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="规格来自「设备样本库」中的交换机样本；接入交换机按信息点计算，PoE 交换机按无线 AP 计算，电话点不占用交换机电口。" />
                            </StackPanel>
                        </Border>

                        <!-- 计算结果：输入（型号 + 可用率）后直接给出所需台数 -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="14,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="计算结果" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="接入交换机合计" Style="{StaticResource MutedText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding AccessSwitchTotal}" FontSize="34"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="台" VerticalAlignment="Bottom" Margin="4,0,0,7"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   Text="{Binding AccessSwitchHint}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                                            Margin="14,4" />

                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="PoE 交换机合计" Style="{StaticResource MutedText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding PoeSwitchTotal}" FontSize="34"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="台" VerticalAlignment="Bottom" Margin="4,0,0,7"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   Text="{Binding PoeSwitchHint}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="按建筑物分别计算" Style="{StaticResource SubSection}"
                                           Margin="0,16,0,4" />
                                <DataGrid ItemsSource="{Binding BuildingSwitchTotals}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" MaxHeight="180"
                                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="建筑物" Binding="{Binding Building}"
                                                            Width="110" MinWidth="100" />
                                        <DataGridTextColumn Header="信息点" Binding="{Binding DataPointCount}"
                                                            Width="85" MinWidth="85" />
                                        <DataGridTextColumn Header="无线 AP" Binding="{Binding ApCount}"
                                                            Width="105" MinWidth="105" />
                                        <DataGridTextColumn Header="接入交换机" Binding="{Binding AccessSwitchCount}"
                                                            Width="115" MinWidth="115" />
                                        <DataGridTextColumn Header="PoE 交换机" Binding="{Binding PoeSwitchCount}"
                                                            Width="115" MinWidth="115" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="每栋建筑物先在楼内按「信息点（PoE 为无线 AP）÷（端口数 × 可用率）」向上取整，再把各楼台数相加；电话点不占用交换机电口。" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
