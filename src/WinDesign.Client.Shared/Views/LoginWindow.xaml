<Window x:Class="WinDesign.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding LoginTitle}"
        Height="640" Width="1040"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="LoginBlueBrush" Color="#0B4F9C" />
        <SolidColorBrush x:Key="LoginBlueMutedBrush" Color="#4A7099" />
        <SolidColorBrush x:Key="LoginDividerBrush" Color="#D8E6F5" />

        <Style x:Key="LoginInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Height" Value="38" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LoginBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource PasswordInput}">
            <Setter Property="Height" Value="38" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource LoginBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource LoginBlueBrush}" />
            <Setter Property="Height" Value="44" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 品牌区：仅平台名称与 SEI logo -->
        <Border Grid.Column="0" BorderBrush="{StaticResource LoginDividerBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#E8F1FB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="56,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="/WinDesign.Client.Shared;component/Assets/sei-logo-horizontal.png"
                       Width="380" HorizontalAlignment="Left"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="PLANT 2D DESIGN PLATFORM"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource LoginBlueMutedBrush}" />
                    <TextBlock Text="工厂二维设计平台"
                               FontFamily="Microsoft YaHei UI" FontSize="46" FontWeight="Light"
                               Foreground="{StaticResource LoginBlueBrush}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Border Width="72" Height="4" CornerRadius="2"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#005BAC" Offset="0" />
                                    <GradientStop Color="#F5A623" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding ModuleName}"
                                   FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource LoginBlueBrush}"
                                   VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 登录表单 -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <StackPanel Width="380" VerticalAlignment="Center">
                <TextBlock Text="登录" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" Margin="0,28,0,6" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LoginInput}" />

                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LoginInput}" />

                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource LoginPasswordInput}" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                <Button Content="登 录" Style="{StaticResource LoginButton}"
                        Margin="0,26,0,0" IsDefault="True" Click="OnLoginClick" />

                <TextBlock Text="正在连接服务器..." Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
