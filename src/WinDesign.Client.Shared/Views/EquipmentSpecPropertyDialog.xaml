<Window x:Class="WinDesign.Client.Views.EquipmentSpecPropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="640" Width="820"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="规格书参数按「参数名 → 参数值」维护，保存时统一写入版本化 JSON 内容。"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{StaticResource WarningBrush}"
                       TextWrapping="Wrap" Text="{Binding ContentWarning}"
                       Visibility="{Binding ContentWarning, Converter={StaticResource StringToVis}}" />

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="所属设备" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding EquipmentOptions}"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedEquipmentId}"
                              IsEnabled="{Binding IsEquipmentEditable}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="规格书编号" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" MaxLength="64" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditSpecCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="规格书名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" MaxLength="200" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditSpecName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="参数" Style="{StaticResource SubSection}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsEditable}">
                        <Button Content="添加参数" Command="{Binding AddParameterCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,5" />
                        <Button Content="删除选中" Command="{Binding RemoveParameterCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,5" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="ParameterGrid" Grid.Row="1"
                          ItemsSource="{Binding Parameters}"
                          SelectedItem="{Binding SelectedParameter}"
                          IsReadOnly="{Binding IsReadOnly}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          ColumnHeaderHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数名" Width="280"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="参数值" Width="*"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"
                            Padding="20,8" Click="OnCancel" />
                    <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Margin="8,0,0,0" IsEnabled="{Binding IsEditable}" Click="OnOk" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
