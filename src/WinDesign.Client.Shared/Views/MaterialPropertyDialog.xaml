<Window x:Class="WinDesign.Client.Views.MaterialPropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="560" Width="760"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="材料/附件按当前项目维护，可关联项目范围内的设备。"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                <StackPanel Width="330" Margin="0,0,14,10">
                    <TextBlock Text="材料编码" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" MaxLength="64" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="330" Margin="0,0,14,10">
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" MaxLength="200" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="330" Margin="0,0,14,10">
                    <TextBlock Text="规格" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditSpec, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="330" Margin="0,0,14,10">
                    <TextBlock Text="材质" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditMaterial, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="155" Margin="0,0,14,10">
                    <TextBlock Text="单位" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="155" Margin="0,0,14,10">
                    <TextBlock Text="数量" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" IsEnabled="{Binding IsEditable}"
                             Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Width="330" Margin="0,0,14,10">
                    <TextBlock Text="关联设备" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding EquipmentOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedEquipmentId}"
                              IsEnabled="{Binding IsEditable}" />
                </StackPanel>
            </WrapPanel>

            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource InputMultiline}" MinHeight="80" IsEnabled="{Binding IsEditable}"
                         Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"
                            Padding="20,8" Click="OnCancel" />
                    <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Margin="8,0,0,0" IsEnabled="{Binding IsEditable}" Click="OnOk" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
